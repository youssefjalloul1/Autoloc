      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Contrats",
      "item": [
        {
          "name": "Lister les contrats",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/contrats"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Statut 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Creer un contrat",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/contrats",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dateSignature\": \"2026-11-02\",\n  \"montantTotal\": 480.00,\n  \"valide\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Statut 201', () => pm.response.to.have.status(201));",
                  "pm.environment.set('contratId', pm.response.json().idContrat);"
                ]
              }
            }
          ]
        },
        {
          "name": "Creer un contrat avec paiements",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/contrats",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dateSignature\": \"2026-11-02\",\n  \"montantTotal\": 480.00,\n  \"valide\": true,\n  \"paiements\": [\n    {\"montant\": 150.00, \"datePaiement\": \"2026-11-02\", \"modePaiement\": \"CARTE\"},\n    {\"montant\": 330.00, \"datePaiement\": \"2026-11-06\", \"modePaiement\": \"VIREMENT\"}\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Statut 201', () => pm.response.to.have.status(201));"]
              }
            }
          ]
        },
        {
          "name": "Consulter un contrat",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/contrats/{{contratId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Statut 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Consulter un contrat inexistant (404)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/contrats/9999"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Statut 404', () => pm.response.to.have.status(404));"]
              }
            }
          ]
        },
        {
          "name": "Modifier un contrat",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/contrats/{{contratId}}",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dateSignature\": \"2026-11-02\",\n  \"montantTotal\": 520.00,\n  \"valide\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Statut 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Supprimer un contrat",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/contrats/{{contratId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Statut 204', () => pm.response.to.have.status(204));"]
              }
            }
          ]
        }
      ]
