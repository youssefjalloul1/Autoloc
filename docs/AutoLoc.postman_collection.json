{
  "info": {
    "name": "AutoLoc",
    "_postman_id": "autoloc-collection-v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Collection Postman pour l'API REST AutoLoc - Atelier 5"
  },
